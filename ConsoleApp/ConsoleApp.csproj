<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
	  <!-- Automatycznie dodaje najczęściej używane przestrzenie nazw, dzięki czemu nie trzeba deklarować ich ręcznie w każdym pliku .cs. -->
	  <ImplicitUsings>enable</ImplicitUsings>
	  <!--Włącza analizę wartości null, pomagając wykrywać możliwe błędy związane z użyciem wartości null-->
    <Nullable>enable</Nullable>
  </PropertyGroup>

	<!-- Konfiguracja globalnych dyrektyw using -->
	<ItemGroup>
		<using Remove="System" />
		<using Include="System.Text.Json" />
	</ItemGroup>

</Project>
