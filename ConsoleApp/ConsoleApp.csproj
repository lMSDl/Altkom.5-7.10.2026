<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
	  <!-- Automatycznie dodaje najczęściej używane przestrzenie nazw, dzięki czemu nie trzeba deklarować ich ręcznie w każdym pliku .cs. -->
	  <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

	<!-- Konfiguracja globalnych dyrektyw using -->
	<ItemGroup>
		<using Remove="System" />
		<using Include="System.Text.Json"/>
	</ItemGroup>

</Project>
